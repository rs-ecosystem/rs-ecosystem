# Fine-grained GitHub token, read-only, for the private app repos
# (ihsanwahyudin/rs-finance, ihsanwahyudin/rs-password).
# Permissions: Contents: Read (releases & downloads), Issues: Read (milestones). Metadata: Read is added automatically.
# Set it in Vercel → Project → Settings → Environment Variables. Without it the site uses the fallbacks in content/.
GITHUB_TOKEN=

# Public URL of the site (sitemap, Open Graph). Defaults to https://rs-ecosystem.ihsan.my.id
NEXT_PUBLIC_SITE_URL=
